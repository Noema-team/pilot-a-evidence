+class TestFailurePayloadContract:
+    """Static drift guards on both sides of the seam."""
+
+    @staticmethod
+    def _worker_payload_keys():
+        with open(RAG_WORKER_MAIN) as f:
+            tree = ast.parse(f.read())
+        for node in ast.walk(tree):
+            if isinstance(node, ast.FunctionDef) and node.name == "build_failure_payload":
+                for sub in ast.walk(node):
+                    if isinstance(sub, ast.Return) and isinstance(sub.value, ast.Dict):
+                        return {
+                            k.value for k in sub.value.keys if isinstance(k, ast.Constant)
+                        }
+        raise AssertionError("build_failure_payload must return a dict literal")
+
+    @staticmethod
+    def _api_details_keys():
+        with open(RAG_API_MAIN) as f:
+            tree = ast.parse(f.read())
+        for node in ast.walk(tree):
+            if isinstance(node, ast.FunctionDef) and node.name == "run_transactional_update":
+                keys = set()
+                for sub in ast.walk(node):
+                    if (
+                        isinstance(sub, ast.Call)
+                        and isinstance(sub.func, ast.Attribute)
+                        and sub.func.attr == "get"
+                        and isinstance(sub.func.value, ast.Name)
+                        and sub.func.value.id == "details"
+                        and sub.args
+                        and isinstance(sub.args[0], ast.Constant)
+                    ):
+                        keys.add(sub.args[0].value)
+                return keys
+        raise AssertionError("run_transactional_update not found")
+
+    def test_worker_publishes_required_failure_keys(self):
+        keys = self._worker_payload_keys()
+        missing = {"error_message", "stage", "retryable"} - keys
+        assert not missing, f"Worker failure payload missing contract keys: {missing}"
+
+    def test_worker_retains_legacy_error_key(self):
+        assert "error" in self._worker_payload_keys(), (
+            "Worker failure payload must retain the legacy `error` key for "
+            "existing status-topic consumers"
+        )
+
+    def test_api_failed_branch_reads_worker_keys(self):
+        keys = self._api_details_keys()
+        missing = {"error_message", "stage", "retryable"} - keys
+        assert not missing, f"rag-api failed branch no longer reads keys: {missing}"
+
+    def test_worker_keys_are_superset_of_api_reads(self):
+        assert {"error_message", "stage", "retryable"}.issubset(self._worker_payload_keys())
+
+    def test_process_document_tracks_stage_and_reports_it(self):
+        with open(RAG_WORKER_MAIN) as f:
+            tree = ast.parse(f.read())
+        fn = next(
+            n for n in ast.walk(tree)
+            if isinstance(n, ast.FunctionDef) and n.name == "process_document"
+        )
+        stage_assignments = [
+            n for n in ast.walk(fn)
+            if isinstance(n, ast.Assign)
+            and any(isinstance(t, ast.Name) and t.id == "current_stage" for t in n.targets)
+        ]
+        # One per pipeline stage plus the init — the tracker must not be
+        # removed or bypassed.
+        assert len(stage_assignments) >= 7, (
+            "process_document must set current_stage before each pipeline step"
+        )
+        handler = next(n for n in fn.body if isinstance(n, ast.ExceptHandler))
+        handler_src = ast.dump(handler)
+        assert "build_failure_payload" in handler_src, (
+            "process_document's failure handler must publish via "
+            "build_failure_payload, not a hand-rolled payload"
+        )
+        assert "current_stage" in handler_src, (
+            "process_document's failure handler must report the tracked stage"
+        )
