+    @staticmethod
+    def build_failure_payload(error_message: str, stage: str, retryable: bool) -> Dict[str, Any]:
+        """
+        Build the failed-status payload published to the status topic.
+
+        Contract (must stay in sync with rag-api's run_transactional_update
+        failed branch, which reads error_message/stage/retryable):
+        - error_message: the actual exception message (rag-api persists it as `error`)
+        - stage: the pipeline stage executing at failure time (persisted as `error_stage`)
+        - retryable: deliberately derived by the caller from classify_error —
+          True for transient errors Pub/Sub will redeliver, False for permanent
+          ones (never silently defaulted on the API side)
+        - error: legacy key retained for continuity with any other consumers
+          of the status topic and existing log tooling
+        """
+        return {
+            "error_message": error_message,
+            "stage": stage,
+            "retryable": retryable,
+            "error": error_message,
+        }
