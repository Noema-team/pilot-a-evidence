+"""Contract test: rag-worker failure payload → rag-api failed-branch persistence.
+
+Pins the worker→rag-api failure contract end to end:
+
+- the worker's build_failure_payload emits error_message / stage / retryable
+  (plus the legacy `error` key) and derives retryable from classify_error;
+- rag-api's run_transactional_update failed branch persists those values
+  unchanged as error / error_stage / retryable and mirrors the same message
+  and stage into the processing/summary error subdocument;
+- AST/source drift guards fail the build if either side's payload keys change.
+
+Both sides are imported (not restated in a fixture), so a key change on either
+side fails here instead of silently re-creating the fallback-values bug.
+"""
+import ast
+import importlib.util
+import os
+import sys
+from unittest.mock import MagicMock
+
+import pytest
+
+import main as rag_api_main  # conftest put rag-api-service on sys.path
+
+RAG_WORKER_DIR = os.path.abspath(
+    os.path.join(os.path.dirname(__file__), "..", "..", "rag-worker-service")
+)
+WORKER_MAIN = os.path.join(RAG_WORKER_DIR, "main.py")
+RAG_API_MAIN = os.path.abspath(
+    os.path.join(os.path.dirname(__file__), "..", "..", "rag-api-service", "main.py")
+)
+
+# Extra third-party mocks the worker needs at import time (conftest already
+# covers the firebase/google ones rag-api needs).
+for _mod in [
+    "langchain",
+    "langchain.text_splitter",
+    "langchain.schema",
+    "openai",
+    "langfuse",
+    "spacy",
+    "sklearn",
+    "sklearn.feature_extraction",
+    "sklearn.feature_extraction.text",
+    "tiktoken",
+    "tenacity",
+    "google.cloud.firestore_v1.base_query",
+    "google.auth",
+    "google.auth.credentials",
+]:
+    sys.modules.setdefault(_mod, MagicMock())
+
+
+def _load_worker_main():
+    spec = importlib.util.spec_from_file_location("rag_worker_main", WORKER_MAIN)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+@pytest.fixture(scope="module")
+def rag_worker_main():
+    return _load_worker_main()
+
+
+# ---------------------------------------------------------------------------
+# Worker side: failure-payload construction
+# ---------------------------------------------------------------------------
+
+
+class TestWorkerFailurePayload:
+    def test_payload_carries_contract_keys(self, rag_worker_main):
+        payload = rag_worker_main.build_failure_payload(ValueError("boom"), "chunking_complete")
+        assert {"error_message", "stage", "retryable"} <= set(payload)
+        assert payload["error_message"] == "boom"
+        assert payload["stage"] == "chunking_complete"
+
+    def test_retryable_true_for_transient(self, rag_worker_main):
+        payload = rag_worker_main.build_failure_payload(
+            rag_worker_main.TransientError("connection reset"), "text_retrieved"
+        )
+        assert payload["retryable"] is True
+
+    def test_retryable_false_for_permanent(self, rag_worker_main):
+        payload = rag_worker_main.build_failure_payload(
+            rag_worker_main.PermanentError("bad input"), "starting"
+        )
+        assert payload["retryable"] is False
+
+    def test_retryable_false_for_unclassified_unknown(self, rag_worker_main):
+        # classify_error's conservative default: unknown exceptions are
+        # permanent, so retryable must be False — not a silent True.
+        payload = rag_worker_main.build_failure_payload(ValueError("weird"))
+        assert payload["retryable"] is False
+        assert payload["stage"] == "processing"
+
+    def test_legacy_error_key_retained(self, rag_worker_main):
+        payload = rag_worker_main.build_failure_payload(ValueError("boom"), "starting")
+        assert payload["error"] == "boom"
+
+
+# ---------------------------------------------------------------------------
+# rag-api side: failed-branch persistence (fake Firestore transaction)
+# ---------------------------------------------------------------------------
+
+
+class _Snapshot:
+    exists = True
+
+    def to_dict(self):
+        return {"status": "processing"}
+
+
+class _DocRef:
+    id = "res-1"
+
+    def get(self, transaction=None):
+        return _Snapshot()
+
+    def collection(self, name):
+        return self
+
+    def document(self, name):
+        return self
+
+
+class _Transaction:
+    def __init__(self, writes):
+        self._writes = writes
+
+    def update(self, ref, data):
+        self._writes["main"] = dict(data)
+
+    def set(self, ref, data, merge=False):
+        self._writes["summary"] = dict(data)
+
+
+class _DB:
+    def __init__(self, writes):
+        self._writes = writes
+
+    def transaction(self):
+        return _Transaction(self._writes)
+
+
+@pytest.fixture(autouse=True)
+def _patch_firestore_helpers(monkeypatch):
+    # Make @firestore.transactional a passthrough so update_logic runs against
+    # the fake transaction above.
+    monkeypatch.setattr(
+        rag_api_main.firestore, "transactional", lambda f: f, raising=False
+    )
+    monkeypatch.setattr(
+        rag_api_main.firestore,
+        "SERVER_TIMESTAMP",
+        "SERVER_TIMESTAMP",
+        raising=False,
+    )
+
+
+def _run_failed_branch(payload):
+    writes = {}
+    rag_api_main.run_transactional_update(
+        _DB(writes), _DocRef(), "failed", payload, rag_api_main.logger, "user-1"
+    )
+    return writes
+
+
+class TestFailurePersistenceContract:
+    def test_worker_payload_persists_verbatim(self, rag_worker_main):
+        payload = rag_worker_main.build_failure_payload(
+            ValueError("embedding call failed"), "embeddings_complete"
+        )
+        writes = _run_failed_branch(payload)
+        assert writes["main"]["error"] == "embedding call failed"
+        assert writes["main"]["error_stage"] == "embeddings_complete"
+        assert writes["main"]["retryable"] is False
+        assert writes["summary"]["error"]["message"] == "embedding call failed"
+        assert writes["summary"]["error"]["stage"] == "embeddings_complete"
+        assert writes["summary"]["stage"] == "embeddings_complete"
+
+    def test_transient_failure_persists_retryable_true(self, rag_worker_main):
+        payload = rag_worker_main.build_failure_payload(
+            rag_worker_main.TransientError("connection reset"), "text_retrieved"
+        )
+        writes = _run_failed_branch(payload)
+        assert writes["main"]["error"] == "connection reset"
+        assert writes["main"]["error_stage"] == "text_retrieved"
+        assert writes["main"]["retryable"] is True
+
+    def test_unknown_stage_defaults_to_processing_not_none(self, rag_worker_main):
+        payload = rag_worker_main.build_failure_payload(ValueError("early boom"))
+        writes = _run_failed_branch(payload)
+        assert writes["main"]["error_stage"] == "processing"
+        assert writes["main"]["error"] == "early boom"
+
+
+# ---------------------------------------------------------------------------
+# Drift guards: either side changing its payload keys fails the build
+# ---------------------------------------------------------------------------
+
+
+def _parse(path):
+    with open(path) as f:
+        return ast.parse(f.read())
+
+
+class TestPayloadDriftGuards:
+    def test_worker_failure_handler_uses_payload_builder_with_stage(self):
+        tree = _parse(WORKER_MAIN)
+        calls = [
+            n
+            for n in ast.walk(tree)
+            if isinstance(n, ast.Call)
+            and isinstance(n.func, ast.Name)
+            and n.func.id == "build_failure_payload"
+        ]
+        assert calls, "worker failure handler must build its payload via build_failure_payload"
+        assert all(len(c.args) >= 2 for c in calls), (
+            "build_failure_payload must be called with (error, stage) — "
+            "the failing stage must be reported"
+        )
+
+    def test_worker_tracks_stage_through_pipeline(self):
+        tree = _parse(WORKER_MAIN)
+        stages = set()
+        for node in ast.walk(tree):
+            if (
+                isinstance(node, ast.Assign)
+                and len(node.targets) == 1
+                and isinstance(node.targets[0], ast.Name)
+                and node.targets[0].id == "current_stage"
+                and isinstance(node.value, ast.Constant)
+            ):
+                stages.add(node.value.value)
+        expected = {
+            "processing",
+            "starting",
+            "text_retrieved",
+            "tagging_complete",
+            "summary_generated",
+            "chunking_complete",
+            "embeddings_complete",
+        }
+        missing = expected - stages
+        assert not missing, f"stage tracker missing stages: {missing}"
+
+    def test_worker_payload_builder_emits_all_contract_keys(self, rag_worker_main):
+        payload = rag_worker_main.build_failure_payload(ValueError("x"), "starting")
+        assert {"error_message", "stage", "retryable", "error"} <= set(payload)
+
+    def test_rag_api_failed_branch_reads_worker_keys(self):
+        with open(RAG_API_MAIN) as f:
+            src = f.read()
+        for key in ("error_message", "stage", "retryable"):
+            assert f'details.get("{key}"' in src, (
+                f"rag-api failed branch must read details key '{key}'"
+            )
