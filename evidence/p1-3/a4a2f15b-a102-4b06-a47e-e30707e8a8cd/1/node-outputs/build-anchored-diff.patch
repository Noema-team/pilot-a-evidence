+def _load_module(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    mod = importlib.util.module_from_spec(spec)
+    sys.modules[name] = mod
+    spec.loader.exec_module(mod)
+    return mod
+
+
+rag_api_main = _load_module("rag_api_failure_contract_main", RAG_API_MAIN)
+worker_main = _load_module("rag_worker_failure_contract_main", RAG_WORKER_MAIN)
+
+
+# ---------------------------------------------------------------------
+# Behavioral tests: worker payload construction → rag-api persistence
+# ---------------------------------------------------------------------
+
+
+def _seed_processing_resource(db, user_id="user1", resource_id="res-1"):
+    path = f"users/{user_id}/resources/{resource_id}"
+    db._docs[path] = {
+        "status": "processing",
+        "userId": user_id,
+        "filename": "test.pdf",
+    }
+    return db.document(path), path
+
+
+class TestWorkerFailurePayloadPersisted:
+    def test_transient_failure_persists_worker_values(self):
+        db = FakeFirestoreDB()
+        doc_ref, path = _seed_processing_resource(db)
+
+        err = httpx.ConnectError("connection to openrouter failed")
+        details = worker_main.build_failure_payload(err, "embeddings_complete")
+
+        rag_api_main.run_transactional_update(db, doc_ref, "failed", details, MagicMock(), "user1")
+
+        data = db._docs[path]
+        assert data["status"] == "failed"
+        # The worker's actual message — never rag-api's "Processing failed" fallback.
+        assert data["error"] == "connection to openrouter failed"
+        # The failing stage — never None.
+        assert data["error_stage"] == "embeddings_complete"
+        # Deliberately derived (transient → True), not the silent default.
+        assert data["retryable"] is True
+
+    def test_permanent_failure_persists_retryable_false(self):
+        db = FakeFirestoreDB()
+        doc_ref, path = _seed_processing_resource(db)
+
+        err = ValueError("Document res-1 has neither extracted text nor a valid source URL")
+        details = worker_main.build_failure_payload(err, "starting")
+
+        rag_api_main.run_transactional_update(db, doc_ref, "failed", details, MagicMock(), "user1")
+
+        data = db._docs[path]
+        assert data["error"] == str(err)
+        assert data["error_stage"] == "starting"
+        # Permanent/unknown errors classify as permanent → retryable False.
+        assert data["retryable"] is False
+
+    def test_unknown_stage_falls_back_to_processing_not_null(self):
+        db = FakeFirestoreDB()
+        doc_ref, path = _seed_processing_resource(db)
+
+        details = worker_main.build_failure_payload(RuntimeError("boom"), None)
+        assert details["stage"] == "processing"
+
+        rag_api_main.run_transactional_update(db, doc_ref, "failed", details, MagicMock(), "user1")
+
+        data = db._docs[path]
+        assert data["error"] == "boom"
+        assert data["error_stage"] == "processing"
+
+    def test_processing_summary_error_subdocument_carries_message_and_stage(self):
+        db = FakeFirestoreDB()
+        doc_ref, path = _seed_processing_resource(db)
+
+        details = worker_main.build_failure_payload(
+            httpx.ReadTimeout("summary generation timed out"), "summary_generated"
+        )
+        rag_api_main.run_transactional_update(db, doc_ref, "failed", details, MagicMock(), "user1")
+
+        summary = db._docs[f"{path}/processing/summary"]
+        assert summary["error"]["message"] == "summary generation timed out"
+        assert summary["error"]["stage"] == "summary_generated"
+        assert summary["error"]["code"] == "UNKNOWN"
+        assert summary["stage"] == "summary_generated"
+        # Same message and stage as the main document.
+        main = db._docs[path]
+        assert main["error"] == summary["error"]["message"]
+        assert main["error_stage"] == summary["error"]["stage"]
+
