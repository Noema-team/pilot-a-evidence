+"""Worker → rag-api failure-path contract test.
+
+Pins the failure payload contract across the Pub/Sub status-topic seam:
+
+- the worker's failure-payload construction (build_failure_payload in
+  rag-worker-service/main.py) must publish error_message / stage /
+  retryable (plus the legacy `error` key),
+- rag-api's failed branch (run_transactional_update in
+  rag-api-service/main.py) must persist those values unchanged as
+  error / error_stage / retryable on the main document and carry the same
+  message and stage into the processing/summary error subdocument.
+
+If either side's keys drift, these tests fail the build instead of
+silently re-creating the "every failure persists as 'Processing failed'
+with a null stage and a fabricated retryable=true" bug.
+"""
+
+import ast
+import importlib.util
+import json
+import os
+import sys
+import types
+from unittest.mock import MagicMock
+
+import httpx
+import pytest
+
+RAG_API_DIR = os.path.normpath(
+    os.path.join(os.path.dirname(__file__), "..", "..", "rag-api-service")
+)
+RAG_WORKER_DIR = os.path.normpath(
+    os.path.join(os.path.dirname(__file__), "..", "..", "rag-worker-service")
+)
+RAG_API_MAIN = os.path.join(RAG_API_DIR, "main.py")
+RAG_WORKER_MAIN = os.path.join(RAG_WORKER_DIR, "main.py")
+
+for _p in (RAG_API_DIR, RAG_WORKER_DIR):
+    if _p not in sys.path:
+        sys.path.insert(0, _p)
+
+os.environ.setdefault("GCP_PROJECT", "test-project")
+os.environ.setdefault("GOOGLE_APPLICATION_CREDENTIALS", "/tmp/fake-creds.json")
+os.environ.setdefault("SHARED_INTERNAL_TOKEN", "test-token")
+
+
+# ---------------------------------------------------------------------
+# Minimal fake Firestore supporting the @firestore.transactional path
+# used by run_transactional_update.
+# ---------------------------------------------------------------------
+
+
+SERVER_TIMESTAMP = "SERVER_TIMESTAMP"
+
+
+class FakeTransaction:
+    def __init__(self, db):
+        self.db = db
+        self._ops = []
+
+    def update(self, ref, data):
+        self._ops.append(("update", ref, data))
+
+    def set(self, ref, data, merge=False):
+        self._ops.append(("set", ref, data, merge))
+
+
+class FakeSnapshot:
+    def __init__(self, data):
+        self._data = data
+
+    @property
+    def exists(self):
+        return self._data is not None
+
+    def to_dict(self):
+        return dict(self._data) if self._data is not None else None
+
+
+class FakeCollectionRef:
+    def __init__(self, db, path):
+        self.db = db
+        self.path = path
+
+    def document(self, name):
+        return FakeDocRef(self.db, f"{self.path}/{name}")
+
+
+class FakeDocRef:
+    def __init__(self, db, path):
+        self.db = db
+        self.path = path
+
+    @property
+    def id(self):
+        return self.path.rsplit("/", 1)[-1]
+
+    def get(self, transaction=None):
+        return FakeSnapshot(self.db._docs.get(self.path))
+
+    def collection(self, name):
+        return FakeCollectionRef(self.db, f"{self.path}/{name}")
+
+
+class FakeFirestoreDB:
+    def __init__(self):
+        self._docs = {}
+
+    def document(self, path):
+        return FakeDocRef(self, path)
+
+    def transaction(self):
+        return FakeTransaction(self)
+
+
+def _transactional(fn):
+    def wrapper(transaction, *args, **kwargs):
+        result = fn(transaction, *args, **kwargs)
+        for op in transaction._ops:
+            if op[0] == "update":
+                _, ref, data = op
+                transaction.db._docs.setdefault(ref.path, {}).update(data)
+            else:
+                _, ref, data, merge = op
+                if merge:
+                    transaction.db._docs.setdefault(ref.path, {}).update(data)
+                else:
+                    transaction.db._docs[ref.path] = dict(data)
+        transaction._ops.clear()
+        return result
+
+    return wrapper
+
+
+# ---------------------------------------------------------------------
+# Module fakes so both services import hermetically.
+# ---------------------------------------------------------------------
+
+
+def _install_module_fakes():
+    fake_firestore = types.ModuleType("firebase_admin.firestore")
+    fake_firestore.transactional = _transactional
+    fake_firestore.SERVER_TIMESTAMP = SERVER_TIMESTAMP
+
+    fake_fb = types.ModuleType("firebase_admin")
+    fake_fb._apps = {}
+    fake_fb.firestore = fake_firestore
+    fake_fb.credentials = MagicMock()
+    fake_fb.auth = MagicMock()
+
+    sys.modules["firebase_admin"] = fake_fb
+    sys.modules["firebase_admin.firestore"] = fake_firestore
+
+    # Heavy third-party deps of the worker that are irrelevant to the
+    # failure-payload code under test.
+    for mod in [
+        "langchain", "langchain.text_splitter", "langchain.schema",
+        "openai", "langfuse", "spacy",
+        "sklearn", "sklearn.feature_extraction",
+        "sklearn.feature_extraction.text",
+        "tiktoken", "tenacity", "pydantic_settings",
+        "google", "google.cloud", "google.cloud.firestore",
+        "google.cloud.firestore_v1", "google.cloud.firestore_v1.base_query",
+        "google.cloud.pubsub_v1", "google.cloud.storage",
+        "google.oauth2", "google.oauth2.service_account",
+        "structlog",
+    ]:
+        sys.modules.setdefault(mod, MagicMock())
+
+
+_install_module_fakes()
